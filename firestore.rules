rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "xuanxiang0609@gmail.com";
    }

    match /members/{uid} {
      allow get, list: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.memberUid == request.auth.uid)
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /dispatch/{dispatchId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /lineEvents/{eventId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
