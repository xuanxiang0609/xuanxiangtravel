  const money = n => Number.isFinite(Number(n)) && Number(n) > 0 ? 'NT$' + Math.round(Number(n)).toLocaleString('zh-TW') : '待客服確認';
  const clampNumber = (value,min,max,fallback=0)=>{
    const n = Number(value);
    if(!Number.isFinite(n)) return fallback;
    return Math.max(min, Math.min(max, n));
  };
  const normalizeVehicleName = value => String(value || '').trim().replace(/\s+/g,'');
  const esc = v => String(v || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));

  const buildQuoteKey = () => [
    text($('#serviceSelect')),
    text($('#serviceDetailSelect')),
    collectArray('pickups').join('|'),
    collectArray('dropoffs').join('|'),
    text($('#vehicleInput'))
  ].join('::');

  function setRemoteQuoteState(next){
    remoteQuoteState = Object.assign({}, remoteQuoteState, next || {});
    estimate();
    updateSummary();
  }

  function scheduleRemoteQuote(){
    if(remoteQuoteTimer) clearTimeout(remoteQuoteTimer);
    remoteQuoteTimer = setTimeout(fetchRemoteQuote, 700);
  }

  async function fetchRemoteQuote(){
    const service = text($('#serviceSelect'));
    if(!AUTO_ESTIMATE_SERVICES.includes(service)) return;

    const pickup = collectArray('pickups')[0] || '';
    const dropoff = collectArray('dropoffs')[0] || '';
    const vehicle = text($('#vehicleInput'));

    if(!pickup || !dropoff || !vehicle || vehicle === '依客服派車') return;

    const key = buildQuoteKey();
    if(remoteQuoteState.key === key && remoteQuoteState.price > 0) return;

    setRemoteQuoteState({
      loading:true,
      key:key,
      message:'Google Maps 測距中'
    });

    try{
      const url = new URL(APPS_SCRIPT_URL);
      url.searchParams.set('action','estimate');
      url.searchParams.set('service',service);
      url.searchParams.set('serviceDetail',text($('#serviceDetailSelect')));
      url.searchParams.set('pickup',pickup);
      url.searchParams.set('dropoff',dropoff);
      url.searchParams.set('vehicle',vehicle);

      const response = await fetch(url.toString(), { method:'GET' });
      if(!response.ok) throw new Error('API 狀態碼 ' + response.status);

      const data = await response.json();
      if(!data || data.ok === false) throw new Error(data?.message || '估價 API 未回傳成功');

      const distanceKm = Number(data.distanceKm || 0);
      const durationMin = Number(data.durationMin || 0);
      const price = Number(data.price || data.baseFare || data.mapFare || 0);

      setRemoteQuoteState({
        loading:false,
        key:key,
        distanceKm:distanceKm,
        durationMin:durationMin,
        price:price,
        vehicleCode:data.vehicleCode || data.fareRule?.code || '',
        fareRule:data.fareRule || null,
        message:data.distanceText ? `${data.distanceText}／${data.durationText || ''}` : 'Google Maps 已完成測距'
      });
    }catch(err){
      setRemoteQuoteState({
        loading:false,
        key:key,
        distanceKm:0,
        durationMin:0,
        price:0,
        vehicleCode:'',
        fareRule:null,
        message:'Google Maps 測距失敗，改由客服確認：' + (err.message || err)
      });
    }
  }

  function showStep(index){
    $$('[data-step-panel]').forEach((p,i)=>p.classList.toggle('is-active',i===index));
    $$('[data-step-tab]').forEach((b,i)=>b.classList.toggle('is-active',i===index));
    form.scrollIntoView({behavior:'smooth',block:'start'});
    updateAll();
  }
