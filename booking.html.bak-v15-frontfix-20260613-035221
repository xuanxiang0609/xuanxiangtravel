  $$('[data-prev]').forEach(btn=>btn.addEventListener('click',()=> currentStep()===0 ? window.scrollTo({top:0,behavior:'smooth'}) : showStep(Math.max(0,currentStep()-1))));
  function currentStep(){ return $$('[data-step-panel]').findIndex(p=>p.classList.contains('is-active')); }

