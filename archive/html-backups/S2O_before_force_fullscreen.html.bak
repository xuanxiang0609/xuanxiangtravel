<script>
(function(){
  const btn=document.querySelector('.mobile-menu-btn');
  const nav=document.querySelector('#s2oNav');
  if(!btn||!nav)return;
  btn.addEventListener('click',()=>{
    const open=nav.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent=open?'× 關閉':'☰ 選單';
  });
  nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('is-open');btn.setAttribute('aria-expanded','false');btn.textContent='☰ 選單';}));
})();
</script>

