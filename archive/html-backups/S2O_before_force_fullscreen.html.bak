<style>
:root{
  --bg:#070707;
  --card:#121212;
  --gold:#d6b46a;
  --gold2:#f5df9a;
  --text:#f7f2e8;
  --muted:#b9b1a3;
  --line:rgba(214,180,106,.28);
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:"Noto Sans TC","Microsoft JhengHei",Arial,sans-serif;
  background:
    radial-gradient(circle at top left,rgba(214,180,106,.22),transparent 32%),
    linear-gradient(180deg,#050505,#111);
  color:var(--text);
}
a{text-decoration:none;color:inherit}
.wrap{width:min(1180px,92%);margin:auto}
.header{
  position:sticky;top:0;z-index:99;
  background:rgba(5,5,5,.86);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.nav{
  height:72px;display:flex;align-items:center;justify-content:space-between;
}
.logo{
  font-weight:900;letter-spacing:.08em;color:var(--gold2);
}
.nav a{
  margin-left:18px;color:var(--muted);font-size:14px;
}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:13px 22px;border-radius:999px;
  background:linear-gradient(135deg,var(--gold2),var(--gold));
  color:#16100a;font-weight:900;
  box-shadow:0 12px 32px rgba(214,180,106,.25);
}
.btn.dark{
  background:rgba(255,255,255,.06);
  color:var(--gold2);
  border:1px solid var(--line);
}
.hero{
  padding:88px 0 64px;
}
.hero-layout{
  display:grid;
  grid-template-columns:minmax(0,1.02fr) minmax(320px,.98fr);
  gap:34px;
  align-items:center;
}
.hero-media{
  position:relative;
  min-height:470px;
  border:1px solid var(--line);
  border-radius:34px;
  overflow:hidden;
  background:#111;
  box-shadow:0 28px 80px rgba(0,0,0,.48);
}
.hero-media img{
  width:100%;height:100%;object-fit:cover;display:block;
  position:absolute;inset:0;
  filter:saturate(1.08) contrast(1.04);
}
.hero-media::after{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.72));
}
.hero-caption{
  position:absolute;left:22px;right:22px;bottom:22px;z-index:2;
  padding:18px 20px;border:1px solid rgba(245,223,154,.26);
  border-radius:22px;background:rgba(0,0,0,.48);backdrop-filter:blur(14px);
}
.hero-caption strong{display:block;color:var(--gold2);font-size:18px;margin-bottom:4px}
.hero-caption span{display:block;color:var(--muted);font-size:14px;line-height:1.7}
.badge{
  display:inline-block;
  padding:8px 14px;border:1px solid var(--line);
  color:var(--gold2);border-radius:999px;
  background:rgba(255,255,255,.04);
  font-size:14px;
}
h1{
  font-size:clamp(38px,6vw,78px);
  line-height:1.06;margin:22px 0 18px;
  letter-spacing:.03em;
}
.hero p{
  max-width:760px;color:var(--muted);
  font-size:18px;line-height:1.9;
}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
.grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
}
.card{
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));
  border:1px solid var(--line);
  border-radius:26px;
  padding:26px;
  box-shadow:0 18px 50px rgba(0,0,0,.22);
}
.card-img{
  width:100%;height:180px;object-fit:cover;display:block;
  border-radius:20px;margin-bottom:18px;
  border:1px solid rgba(214,180,106,.2);
  background:#0f0f0f;
}
.gallery{
  display:grid;
  grid-template-columns:1.2fr .8fr .8fr;
  gap:18px;
}
.gallery figure{
  margin:0;position:relative;overflow:hidden;border-radius:26px;
  border:1px solid var(--line);background:#111;min-height:260px;
}
.gallery figure:first-child{min-height:420px;grid-row:span 2}
.gallery img{width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0}
.gallery figcaption{
  position:absolute;left:16px;right:16px;bottom:16px;z-index:2;
  padding:13px 15px;border-radius:16px;
  background:rgba(0,0,0,.55);border:1px solid rgba(245,223,154,.22);
  color:var(--gold2);font-weight:900;backdrop-filter:blur(12px);
}
.gallery figure::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,transparent 45%,rgba(0,0,0,.78));
}
.card h3{color:var(--gold2);margin:0 0 12px;font-size:22px}
.card p,.card li{color:var(--muted);line-height:1.8}
.section{padding:56px 0}
.title{
  display:flex;align-items:end;justify-content:space-between;gap:20px;
  margin-bottom:24px;
}
.title h2{font-size:clamp(28px,4vw,46px);margin:0}
.title span{color:var(--gold);font-weight:800}
.timeline{
  display:grid;gap:16px;
}
.trip-map{
  position:relative;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
  margin:24px 0 30px;
}
.trip-map::before{
  content:"";
  position:absolute;
  left:8%;right:8%;top:58px;height:2px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  opacity:.62;
}
.trip-node{
  position:relative;
  z-index:1;
  border:1px solid var(--line);
  border-radius:28px;
  overflow:hidden;
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));
  box-shadow:0 18px 48px rgba(0,0,0,.26);
}
.trip-node img{
  width:100%;height:190px;object-fit:cover;display:block;
  background:#101010;
  filter:saturate(1.08) contrast(1.05);
}
.trip-node-body{padding:22px}
.trip-dot{
  width:42px;height:42px;border-radius:999px;
  display:grid;place-items:center;
  margin:-42px 0 14px;
  position:relative;z-index:2;
  background:linear-gradient(135deg,var(--gold2),var(--gold));
  color:#111;font-weight:1000;
  box-shadow:0 12px 28px rgba(214,180,106,.32);
}
.trip-node h3{margin:0 0 8px;color:var(--gold2);font-size:21px}
.trip-node p{margin:0;color:var(--muted);line-height:1.8}
.route-poster{
  margin-top:18px;
  border:1px solid var(--line);
  border-radius:30px;
  padding:26px;
  background:
    radial-gradient(circle at top right,rgba(214,180,106,.16),transparent 34%),
    linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.025));
}
.route-poster-head{
  display:flex;justify-content:space-between;gap:16px;align-items:flex-start;
  border-bottom:1px solid var(--line);
  padding-bottom:18px;margin-bottom:18px;
}
.route-poster-head strong{display:block;color:var(--gold2);font-size:24px;letter-spacing:.04em}
.route-poster-head span{color:var(--muted);line-height:1.7}
.route-list{display:grid;gap:12px;margin:0;padding:0;list-style:none}
.route-list li{
  display:grid;grid-template-columns:92px 1fr;gap:14px;align-items:center;
  padding:14px 16px;border:1px solid rgba(214,180,106,.18);
  border-radius:18px;background:rgba(0,0,0,.24);
}
.route-list b{color:var(--gold2)}
.route-list span{color:var(--muted);line-height:1.7}
.day{
  display:grid;grid-template-columns:120px 1fr;gap:18px;
}
.day .time{
  color:#111;background:linear-gradient(135deg,var(--gold2),var(--gold));
  border-radius:18px;padding:16px;text-align:center;font-weight:900;
}
.day .box{
  border:1px solid var(--line);border-radius:22px;padding:22px;
  background:rgba(255,255,255,.045);
}
.day h3{margin:0 0 8px;color:var(--gold2)}
.day p{margin:0;color:var(--muted);line-height:1.8}
.price{font-size:34px;font-weight:900;color:var(--gold2)}
.notice{
  border:1px dashed var(--line);
  border-radius:22px;padding:22px;color:var(--muted);
  background:rgba(214,180,106,.06);
}
.footer{
  margin-top:60px;padding:40px 0;
  border-top:1px solid var(--line);
  color:var(--muted);font-size:14px;
}
.float{position:fixed;right:18px;bottom:18px;z-index:100}
@media(max-width:860px){
  .nav a:not(.btn){display:none}
  .hero-layout{grid-template-columns:1fr}
  .hero-media{min-height:360px}
  .grid{grid-template-columns:1fr}
  .gallery{grid-template-columns:1fr}
  .gallery figure,.gallery figure:first-child{min-height:260px;grid-row:auto}
  .trip-map{grid-template-columns:1fr}
  .trip-map::before{display:none}
  .route-poster-head{display:block}
  .route-list li{grid-template-columns:1fr}
  .day{grid-template-columns:1fr}
  .hero{padding:70px 0 44px}
}

.mobile-menu-btn{display:none;border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--gold2);border-radius:999px;padding:10px 14px;font-weight:900}
@media(max-width:860px){
  .nav{height:auto;min-height:68px;align-items:flex-start;padding:14px 0;gap:12px;flex-wrap:wrap}
  .mobile-menu-btn{display:inline-flex;margin-left:auto}
  .nav nav{display:none;width:100%;max-height:72vh;overflow-y:auto;padding:12px;border:1px solid var(--line);border-radius:18px;background:rgba(5,5,5,.96)}
  .nav nav.is-open{display:grid;gap:10px}
  .nav nav a{display:block;margin:0;padding:13px 12px;border-radius:14px;background:rgba(255,255,255,.045)}
  .nav nav a.btn{display:flex}
}
</style>
