:root{--xx-bg:#090806;--xx-card:#14110b;--xx-gold:#d8b35a;--xx-gold-2:#f2d17a;--xx-text:#fff8e8;--xx-muted:#b7ab92;--xx-line:rgba(216,179,90,.22);--xx-danger:#ff6b6b;--xx-ok:#55d68b;--xx-warn:#ffc65a;--xx-shadow:0 22px 70px rgba(0,0,0,.42);--xx-radius:22px}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC","Microsoft JhengHei",sans-serif;color:var(--xx-text);background:radial-gradient(circle at 10% 0%,rgba(216,179,90,.16),transparent 36%),linear-gradient(135deg,#050403,#11100c 48%,#070605)}button,input,select,textarea{font:inherit}button{cursor:pointer}.xx-admin-shell{min-height:100vh;display:grid;grid-template-columns:290px 1fr}.xx-sidebar{position:sticky;top:0;height:100vh;padding:22px 18px;border-right:1px solid var(--xx-line);background:linear-gradient(180deg,rgba(20,17,11,.96),rgba(8,7,5,.98));overflow:auto}.xx-brand{display:flex;gap:13px;align-items:center;color:var(--xx-text);text-decoration:none;margin-bottom:22px}.xx-brand-mark{width:46px;height:46px;border-radius:16px;display:grid;place-items:center;color:#191004;font-weight:900;font-size:24px;background:linear-gradient(135deg,var(--xx-gold-2),var(--xx-gold));box-shadow:0 10px 28px rgba(216,179,90,.24)}.xx-brand strong{display:block;font-size:18px;letter-spacing:.08em}.xx-brand small{color:var(--xx-muted)}.xx-nav{display:grid;gap:8px}.xx-nav-item{width:100%;border:1px solid transparent;border-radius:16px;padding:13px 14px;text-align:left;color:var(--xx-muted);background:transparent}.xx-nav-item:hover,.xx-nav-item.is-active{color:var(--xx-text);border-color:var(--xx-line);background:linear-gradient(135deg,rgba(216,179,90,.18),rgba(255,255,255,.03))}.xx-sidebar-card{margin-top:22px;padding:16px;border:1px solid var(--xx-line);border-radius:18px;background:rgba(255,255,255,.04)}.xx-sidebar-card b{display:block}.xx-sidebar-card span{color:var(--xx-ok);font-size:13px}.xx-main{padding:24px;min-width:0}.xx-topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px;padding:18px 20px;border:1px solid var(--xx-line);border-radius:var(--xx-radius);background:rgba(20,17,11,.72);backdrop-filter:blur(16px);box-shadow:var(--xx-shadow)}.xx-kicker{margin:0 0 4px;color:var(--xx-gold);font-size:12px;letter-spacing:.18em;text-transform:uppercase}h1,h2,p{margin-top:0}h1{margin-bottom:0;font-size:28px}h2{font-size:20px;margin-bottom:0}.xx-topbar-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.xx-icon-btn,.xx-btn{border:1px solid var(--xx-line);border-radius:14px;padding:11px 15px;color:var(--xx-text);background:rgba(255,255,255,.04)}.xx-btn-gold{color:#171006;background:linear-gradient(135deg,var(--xx-gold-2),var(--xx-gold));border-color:transparent;font-weight:800}.xx-alert{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 18px;border:1px solid var(--xx-line);border-radius:18px;padding:14px 16px;background:linear-gradient(135deg,rgba(216,179,90,.14),rgba(255,255,255,.03))}.xx-alert span{color:var(--xx-muted)}.xx-panel{display:none}.xx-panel.is-active{display:block}.xx-grid{display:grid;gap:18px;margin-bottom:18px}.xx-grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}.xx-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.xx-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.xx-card{border:1px solid var(--xx-line);border-radius:var(--xx-radius);padding:20px;background:linear-gradient(180deg,rgba(20,17,11,.88),rgba(12,10,7,.88));box-shadow:var(--xx-shadow)}.xx-card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:16px}.xx-card-head span{color:var(--xx-muted);font-size:13px}.xx-kpi strong{display:block;font-size:30px}.xx-kpi span{color:var(--xx-muted)}.xx-kpi small{color:var(--xx-gold)}.xx-tools{display:flex;gap:10px;flex-wrap:wrap}.xx-input{width:100%;border:1px solid var(--xx-line);border-radius:14px;color:var(--xx-text);background:#0c0a07;padding:12px 13px;outline:none}.xx-table-wrap{overflow:auto;border-radius:16px;border:1px solid rgba(216,179,90,.12)}.xx-table{width:100%;border-collapse:collapse;min-width:900px}.xx-table th,.xx-table td{padding:13px 14px;border-bottom:1px solid rgba(216,179,90,.12);text-align:left;vertical-align:top}.xx-table th{color:var(--xx-gold);background:rgba(216,179,90,.08);font-size:13px}.xx-table td{color:#f8edd5}.xx-badge{display:inline-flex;align-items:center;border-radius:999px;padding:6px 10px;border:1px solid var(--xx-line);font-size:12px}.xx-badge.ok{color:var(--xx-ok)}.xx-badge.warn{color:var(--xx-warn)}.xx-badge.danger{color:var(--xx-danger)}.xx-stack{display:grid;gap:12px}.xx-mini-card{padding:14px;border:1px solid rgba(216,179,90,.14);border-radius:16px;background:rgba(255,255,255,.035)}.xx-mini-card b{display:block;margin-bottom:5px}.xx-mini-card p{color:var(--xx-muted);margin-bottom:8px}.xx-calendar{min-height:620px;background:#fff;color:#171006;border-radius:18px;padding:12px;overflow:hidden}.xx-form{display:grid;gap:14px;max-width:760px}.xx-form label{display:grid;gap:8px;color:var(--xx-gold)}.xx-code{white-space:pre-wrap;margin:18px 0 0;padding:14px;border:1px solid var(--xx-line);border-radius:16px;color:var(--xx-muted);background:#090806}.xx-map{min-height:520px;border:1px dashed var(--xx-line);border-radius:20px;display:grid;place-items:center;text-align:center;color:var(--xx-muted);padding:22px;background:linear-gradient(135deg,rgba(216,179,90,.08),rgba(255,255,255,.03))}@media (max-width:1180px){.xx-grid-4{grid-template-columns:repeat(2,minmax(0,1fr))}.xx-grid-3,.xx-grid-2{grid-template-columns:1fr}}@media (max-width:860px){.xx-admin-shell{grid-template-columns:1fr}.xx-sidebar{position:fixed;z-index:20;inset:0 auto 0 0;width:min(86vw,310px);transform:translateX(-105%);transition:.25s ease}.xx-admin-shell[data-sidebar="open"] .xx-sidebar{transform:translateX(0)}.xx-main{padding:14px}.xx-topbar{align-items:flex-start;flex-direction:column}.xx-grid-4{grid-template-columns:1fr}}
